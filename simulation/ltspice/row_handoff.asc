TEXT 32 1480 Left 2 !.param ILED=1.2*42/3300
TEXT 32 1512 Left 2 !.step param TGUARD list 10u 100u
TEXT 32 1544 Left 2 !.step param CGATE list 1n 4n
TEXT 32 1576 Left 2 !.model PMOS_ASSUMED VDMOS(pchan Vto=-1 Kp=20 Rd=0.025 Rs=0.025 Cgs=1n Cgdmax=300p Cgdmin=50p Cjo=100p Is=1n)
TEXT 32 1608 Left 2 !.model ULN_EQ SW(Ron=20 Roff=1G Vt=2.5 Vh=-0.1)
TEXT 32 1640 Left 2 !.model LED_RED D(Is=1e-18 N=2 Rs=2 Cjo=10p)
TEXT 32 1672 Left 2 !.model LED_GREEN D(Is=1e-23 N=2 Rs=3 Cjo=10p)
TEXT 32 1704 Left 2 !.tran 0 1.6m 0 100n
TEXT 32 1736 Left 2 !.options plotwinsize=0
TEXT 32 1768 Left 2 !.save V(V5) V(DRAIN0) V(GATE0) V(GATE1) V(ANODE0) V(ANODE1) V(BLANK) V(CTL0) V(CTL1) I(VSENSE0) I(VSENSE1) I(D0R) I(D0G) I(D1R) I(D1G) I(VDD) V(KR) V(KG)
TEXT 32 1800 Left 2 !.meas tran LED_PEAK MAX (I(VSENSE0)+I(VSENSE1)) FROM 400u TO 800u
TEXT 32 1832 Left 2 !.meas tran LED_STEADY AVG (I(VSENSE0)+I(VSENSE1)) FROM 400u TO 800u
TEXT 32 1864 Left 2 !.meas tran BLANK_LEAK MAX (I(D0R)+I(D0G)+I(D1R)+I(D1G)) FROM 1.0001m TO {1m+TGUARD-0.1u}
TEXT 32 1896 Left 2 !.meas tran GHOST_OLD MAX (I(D0R)+I(D0G)) FROM {1m+TGUARD+2u} TO 1.4m
TEXT 32 1928 Left 2 !.meas tran NEW_ROW AVG I(VSENSE1) FROM 1.4m TO 1.5m
TEXT 32 1960 Left 2 !.meas tran RAIL_MIN MIN V(V5) FROM 125u TO 1.5m
TEXT 32 1992 Left 2 !.meas tran PMOS0_DROP AVG V(V5,DRAIN0) FROM 400u TO 800u
TEXT 32 2024 Left 2 !.meas tran PMOS0_POWER AVG (V(V5,DRAIN0)*I(VSENSE0)) FROM 400u TO 800u
TEXT 32 2056 Left 2 !.meas tran GHOST_CHARGE INTEG (I(D0R)+I(D0G)) FROM {1m+TGUARD+2u} TO 1.4m
TEXT 32 2088 Left 2 !.meas tran SINK_RED_POWER AVG (V(KR)*(I(D0R)+I(D1R))) FROM 400u TO 800u
