VGP7 GP7 GND PWL FILE="gpio_SCLK_G.pwl"
VGP8 GP8 GND PWL FILE="gpio_LAT_G.pwl"
VGP9 GP9 GND PWL FILE="gpio_BLANK_G.pwl"
VEN GP10 GND 3.3
V3V3 3V3_OUT GND 3.3
.ends PICO_STIM
