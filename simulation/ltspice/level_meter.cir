3-channel PWM filter and high-impedance Pico reset test
VDD VIN 0 5
RFEED VIN 5V 0.1
CBULK 5V 0 100u Rser=0.1
VPWM_CPU DRIVE_CPU 0 PULSE(0 {VGPIO} 100m 20n 20n {DT0*50u} 50u)
SIO_CPU DRIVE_CPU PWM_CPU EN 0 GPIO_SW
RPD_CPU PWM_CPU 0 10k
RF_CPU PWM_CPU SIG_CPU {4700*RFAC}
CF_CPU SIG_CPU 0 {CFVAL}
XU_CPU K_CPU_1_SINK 0 VCC_CPU 0 SIG_CPU REF_CPU REF_CPU 0 5V K_CPU_10_SINK K_CPU_9_SINK K_CPU_8_SINK K_CPU_7_SINK K_CPU_6_SINK K_CPU_5_SINK K_CPU_4_SINK K_CPU_3_SINK K_CPU_2_SINK XD3914 VREFVAL={VR0} RLAD={RLADVAL} ERR={THERR} ISCALE={ISCALE}
VLOGIC_CPU 5V VCC_CPU 0
RSET_CPU REF_CPU 0 {3300*RSETFAC}
CD_CPU 5V 0 100n
CB_CPU 5V 0 10u Rser=0.1
XLED_CPU 5V 5V 5V 5V 5V 5V 5V 5V 5V 5V K_CPU_10 K_CPU_9 K_CPU_8 K_CPU_7 K_CPU_6 K_CPU_5 K_CPU_4 K_CPU_3 K_CPU_2 K_CPU_1 OSX10201_GYR1
VS_CPU_1 K_CPU_1 K_CPU_1_SINK 0
