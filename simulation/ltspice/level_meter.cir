XU_GPU K_GPU_1_SINK 0 VCC_GPU 0 SIG_GPU REF_GPU REF_GPU 0 5V K_GPU_10_SINK K_GPU_9_SINK K_GPU_8_SINK K_GPU_7_SINK K_GPU_6_SINK K_GPU_5_SINK K_GPU_4_SINK K_GPU_3_SINK K_GPU_2_SINK XD3914 VREFVAL={VR1} RLAD={RLADVAL} ERR={THERR} ISCALE={ISCALE}
